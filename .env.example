# Supabase project URL (public, safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key (server-side only, NEVER expose to the client)
# Find in Supabase Dashboard → Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT secret for signing auth tokens. Generate a strong random string for production.
# Example: openssl rand -base64 32
JWT_SECRET=change-me-to-a-strong-random-secret
