# Supabase Postgres connection string.
# Find in Supabase Dashboard → Settings → Database → Connection string → URI.
# Use the direct connection (db.<project-ref>.supabase.co:5432) for Prisma migrations.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# JWT secret for signing auth tokens. Generate a strong random string for production.
# Example: openssl rand -base64 32
JWT_SECRET=change-me-to-a-strong-random-secret
