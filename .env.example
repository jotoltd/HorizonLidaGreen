# Supabase project URL (public, safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key (server-side only, NEVER expose to the client)
# Find in Supabase Dashboard → Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT secret for signing auth tokens. Generate a strong random string for production.
# Example: openssl rand -base64 32
JWT_SECRET=change-me-to-a-strong-random-secret

# Resend API key for sending email notifications.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# From address for outbound emails. Must be a verified domain in Resend.
FROM_EMAIL=notifications@horizonlidagreen.com

# Twilio credentials for SMS notifications.
# Account SID and Auth Token: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token

# Twilio phone number used to send SMS messages. Must be a valid Twilio number.
TWILIO_PHONE_NUMBER=+15555555555

# Optional country code for local numbers entered without a + prefix (e.g. 64 for NZ).
TWILIO_DEFAULT_COUNTRY_CODE=64

# Admin phone number to receive SMS alerts (receipts, claim documents, new bookings).
ADMIN_NOTIFICATION_PHONE=+15555555555
